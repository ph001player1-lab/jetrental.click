# Caddy сам получает и продлевает HTTPS-сертификаты (Let's Encrypt).
#   bot.jetrental.click   — вебхуки ботов и /health → контейнер bot
#   staff.jetrental.click — сайт сотрудников (web/staff) + /api/staff/* → bot
#   jetrental.click       — сайт аренды: страницы собирает bot, картинки,
#                           стили и скрипты — из web/site. До переезда
#                           kokoncar.com закрыт от поисковиков (основной
#                           сайт в поиске — kokoncar.com)
#   www.jetrental.click   — переадресация на jetrental.click
#   kokon.jetrental.click — тестовая копия сайта KokonCar в дизайне старого kokoncar.com
#                           (до переезда kokoncar.com, закрыта от поисковиков)

# Общие настройки публичного сайта (бренд бот выбирает по домену)
(public_site) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@images path /img/*
	header @images Cache-Control "public, max-age=604800"
	# site.js?v=<хеш> и фото из /uploads (в имени хэш): при изменении меняется адрес
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=31536000, immutable"
	handle /api/public/* {
		reverse_proxy bot:3000
	}
	# Фото, загруженные через сайт сотрудников (том site_uploads)
	handle /uploads/* {
		root * /srv
		file_server
	}
	@static path /img/* *.css *.js
	handle @static {
		root * /srv/web/site
		file_server
	}
	# Страницы, sitemap.xml, robots.txt, переадресации со старых адресов
	handle {
		reverse_proxy bot:3000
	}
}

{$BOT_DOMAIN} {
	encode gzip
	reverse_proxy bot:3000
}

{$STAFF_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		# Телефоны всегда проверяют, не обновился ли портал (у API свой заголовок)
		?Cache-Control "no-cache"
		-Server
	}
	handle /api/staff/* {
		reverse_proxy bot:3000
	}
	# Фото моделей во вкладке Website — те же файлы, что на сайте
	handle /img/* {
		root * /srv/web/site
		file_server
	}
	handle /uploads/* {
		root * /srv
		file_server
	}
	handle {
		root * /srv/web/staff
		try_files {path} /index.html
		file_server
	}
}

{$SITE_DOMAIN} {
	import public_site
	header X-Robots-Tag "noindex, nofollow"
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$KOKON_PREVIEW_DOMAIN} {
	import public_site
	header X-Robots-Tag "noindex, nofollow"
}
